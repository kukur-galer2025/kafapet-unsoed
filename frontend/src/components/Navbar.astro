---
const pathname = Astro.url.pathname;
const getNavClass = (path) => {
  const isActive = path === '/' ? pathname === '/' : pathname.startsWith(path);
  return isActive 
    ? "flex items-center gap-1.5 text-slate-900 bg-slate-100/80 px-4 py-2 rounded-full text-sm font-semibold transition-all shadow-sm"
    : "flex items-center gap-1.5 text-slate-500 hover:text-slate-900 hover:bg-slate-50 px-4 py-2 rounded-full text-sm font-medium transition-all group";
};
const getIconClass = (path) => {
  const isActive = path === '/' ? pathname === '/' : pathname.startsWith(path);
  return isActive 
    ? "w-4 h-4 text-emerald-600" 
    : "w-4 h-4 text-slate-400 group-hover:text-emerald-500 transition-colors";
};
---
<nav class="fixed top-4 left-0 right-0 z-50 transition-all duration-300 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto bg-white/80 backdrop-blur-2xl border border-white/50 shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-full px-4 sm:px-8 flex justify-between items-center h-16 relative">
    
    <!-- LEFT: Logo -->
    <div class="flex items-center">
      <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white font-serif font-bold text-lg shadow-md group-hover:scale-105 transition-transform duration-300">
          K
        </div>
        <div class="flex flex-col">
          <span class="font-sans font-bold text-lg text-slate-900 tracking-tight leading-none">KAFAPET</span>
          <span class="text-[9px] font-semibold tracking-[0.25em] text-emerald-600 uppercase mt-0.5">Unsoed</span>
        </div>
      </a>
    </div>

    <!-- CENTER: Nav Links -->
    <div class="hidden md:flex flex-1 justify-center items-center space-x-1 px-2">
      <a href="/" class={getNavClass('/')}>
        <svg class={getIconClass('/')} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Beranda
      </a>
      <a href="/network" class={getNavClass('/network')}>
        <svg class={getIconClass('/network')} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        Jejaring
      </a>
      <a href="/alumni" class={getNavClass('/alumni')}>
        <svg class={getIconClass('/alumni')} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
        Direktori
      </a>
      <a href="/jobs" class={getNavClass('/jobs')}>
        <svg class={getIconClass('/jobs')} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Karir
      </a>
      <a href="/articles" class={getNavClass('/articles')}>
        <svg class={getIconClass('/articles')} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        Artikel
      </a>
    </div>
    
    <!-- RIGHT: Actions & Auth -->
    <div class="hidden md:flex items-center gap-3">
      <a href="/donasi" class="flex items-center gap-1.5 text-rose-600 bg-rose-50 hover:bg-rose-100 hover:text-rose-700 px-4 py-2 rounded-full text-sm font-bold transition-all shadow-sm">
        <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
        Donasi
      </a>
      
      <div class="w-px h-6 bg-slate-200 mx-1"></div>

      {Astro.cookies.has('token') ? (
        <div class="relative group/nav z-50">
          <button class="flex items-center gap-2 px-3 py-1.5 rounded-full hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all cursor-pointer">
            <div id="nav-avatar" class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400 to-sky-500 flex items-center justify-center text-white font-bold text-xs shadow-sm overflow-hidden">
              U
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover/nav:text-emerald-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <!-- Dropdown menu -->
          <div class="absolute right-0 mt-2 w-48 bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-300 transform translate-y-2 group-hover/nav:translate-y-0 overflow-hidden">
            <div class="p-2 space-y-1">
              <a href="/profile" class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 rounded-xl transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                Profil Saya
              </a>
              <a href="/network" class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 rounded-xl transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Jejaring
              </a>
              <div class="h-px bg-slate-100 my-1"></div>
              <button id="logoutBtn" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded-xl transition-colors text-left">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                Keluar
              </button>
            </div>
          </div>
        </div>
      ) : (
        <>
          <a href="/login" class="text-slate-600 hover:text-emerald-700 px-4 py-2 rounded-full font-medium transition-colors text-sm">Masuk</a>
          <a href="/register" class="relative group px-6 py-2.5 rounded-full overflow-hidden bg-slate-900 text-white font-medium text-sm transition-all shadow-md hover:shadow-xl hover:-translate-y-0.5">
            <div class="absolute inset-0 w-0 bg-emerald-600 transition-all duration-[300ms] ease-out group-hover:w-full"></div>
            <span class="relative">Daftar Sekarang</span>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<script>
  // Add logout logic
  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
    window.location.href = '/login';
  });

  // Load avatar dynamically
  const match = document.cookie.match(/(^|;)\s*token\s*=\s*([^;]+)/);
  const navToken = match ? match[2] : null;
  if(navToken) {
    fetch('http://localhost:3000/api/v1/auth/me', { headers: { 'Authorization': `Bearer ${navToken}` }})
      .then(res => res.json())
      .then(data => {
        const navAvatar = document.getElementById('nav-avatar');
        if(navAvatar && data.profile) {
          if(data.profile.foto_profil) {
            navAvatar.innerHTML = `<img src="${data.profile.foto_profil}" class="w-full h-full object-cover" />`;
          } else if(data.profile.full_name) {
            const initials = data.profile.full_name.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase();
            navAvatar.textContent = initials;
          }
        }
      }).catch(()=>{});
  }
</script>

<script>
  // Slider Logic
  const slides = document.querySelectorAll('.slide');
  const dots = document.querySelectorAll('#slider-dots button');
  let currentSlide = 0;
  let slideInterval;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      const contents = slide.querySelectorAll('.slide-content');
      
      if (i === index) {
        // Show current slide
        slide.classList.replace('opacity-0', 'opacity-100');
        slide.classList.replace('z-0', 'z-10');
        dots[i].classList.replace('bg-white/50', 'bg-white');
        dots[i].classList.replace('w-2', 'w-8');
        
        // Animate content up
        setTimeout(() => {
          contents.forEach(el => {
            el.classList.remove('translate-y-8', 'opacity-0');
            el.classList.add('translate-y-0', 'opacity-100');
          });
        }, 50);
      } else {
        // Hide other slides
        slide.classList.replace('opacity-100', 'opacity-0');
        slide.classList.replace('z-10', 'z-0');
        dots[i].classList.replace('bg-white', 'bg-white/50');
        dots[i].classList.replace('w-8', 'w-2');
        
        // Reset content position
        contents.forEach(el => {
          el.classList.remove('translate-y-0', 'opacity-100');
          el.classList.add('translate-y-8', 'opacity-0');
        });
      }
    });
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  }

  function startSlider() {
    slideInterval = setInterval(nextSlide, 5000); // 5 seconds per slide
  }

  function resetSliderTimer() {
    clearInterval(slideInterval);
    startSlider();
  }

  // Add click events to dots
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      currentSlide = i;
      showSlide(currentSlide);
      resetSliderTimer();
    });
  });

  // Initialize all functions
  if(slides.length > 0) {
    showSlide(0);
    startSlider();
  }
</script>

---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import slide1 from '../assets/images/slider/slide1.jpg';
import slide2 from '../assets/images/slider/slide2.jpg';
import slide3 from '../assets/images/slider/slide3.jpg';

import galleryAlumniGathering from '../assets/images/gallery_alumni_gathering.jpg';
import galleryGraduation from '../assets/images/gallery_graduation.jpg';
import galleryPoultry from '../assets/images/gallery_poultry.jpg';
import galleryVet from '../assets/images/gallery_vet.jpg';
import galleryFarm from '../assets/images/gallery_farm.jpg';
---

<BaseLayout title="Beranda | Modern & Premium">
  <!-- Hero Slider Section -->
  <section class="relative min-h-[95vh] w-full overflow-hidden" id="hero-slider">
    
    <!-- Slides Container -->
    <div class="relative w-full h-full min-h-[95vh]">
      
      <!-- Slide 1 -->
      <div class="slide absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out z-10">
        <div class="absolute inset-0 bg-slate-900/60 z-10"></div>
        <Image src={slide1} alt="Kampus Unsoed" class="absolute inset-0 w-full h-full object-cover z-0" />
        <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center items-center text-center pt-10 pb-24 sm:pb-32">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 shadow-sm mb-6 slide-content transform translate-y-0 opacity-100 transition-all duration-700">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_10px_#34D399]"></span>
            <span class="text-xs font-semibold tracking-[0.2em] text-white uppercase">Satu Kandang</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] font-sans font-extrabold tracking-tight text-white leading-[1.1] mb-6 max-w-5xl slide-content transform translate-y-0 opacity-100 transition-all duration-700 delay-100">
            Merajut Jejak Karsa, <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-sky-400 inline-block pb-2">
              Satu Perjuangan.
            </span>
          </h1>
          <p class="text-lg md:text-xl text-slate-200 max-w-2xl font-light leading-relaxed mb-4 sm:mb-10 slide-content transform translate-y-0 opacity-100 transition-all duration-700 delay-200">
            Kembali ke akar, merawat silaturahmi. Bersama membangun kejayaan dan jaringan kuat Fakultas Peternakan Universitas Jenderal Soedirman.
          </p>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out z-0">
        <div class="absolute inset-0 bg-slate-900/60 z-10"></div>
        <Image src={slide2} alt="Networking" class="absolute inset-0 w-full h-full object-cover z-0" />
        <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center items-center text-center pt-10 pb-24 sm:pb-32">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 shadow-sm mb-6 slide-content transform translate-y-8 opacity-0 transition-all duration-700">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shadow-[0_0_10px_#FBBF24]"></span>
            <span class="text-xs font-semibold tracking-[0.2em] text-white uppercase">Karir & Bisnis</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] font-sans font-extrabold tracking-tight text-white leading-[1.1] mb-6 max-w-5xl slide-content transform translate-y-8 opacity-0 transition-all duration-700 delay-100">
            Jaringan Profesional <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400 inline-block pb-2">
              Tanpa Batas.
            </span>
          </h1>
          <p class="text-lg md:text-xl text-slate-200 max-w-2xl font-light leading-relaxed mb-4 sm:mb-10 slide-content transform translate-y-8 opacity-0 transition-all duration-700 delay-200">
            Temukan kolega bisnis, perluas wawasan industri, dan gapai karir impian melalui ekosistem alumni peternakan eksklusif.
          </p>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out z-0">
        <div class="absolute inset-0 bg-slate-900/60 z-10"></div>
        <Image src={slide3} alt="Gala Dinner" class="absolute inset-0 w-full h-full object-cover z-0" />
        <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center items-center text-center pt-10 pb-24 sm:pb-32">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 shadow-sm mb-6 slide-content transform translate-y-8 opacity-0 transition-all duration-700">
            <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse shadow-[0_0_10px_#38BDF8]"></span>
            <span class="text-xs font-semibold tracking-[0.2em] text-white uppercase">Sinergi Alumni</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] font-sans font-extrabold tracking-tight text-white leading-[1.1] mb-6 max-w-5xl slide-content transform translate-y-8 opacity-0 transition-all duration-700 delay-100">
            Wujudkan Inspirasi <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-indigo-400 inline-block pb-2">
              & Kolaborasi.
            </span>
          </h1>
          <p class="text-lg md:text-xl text-slate-200 max-w-2xl font-light leading-relaxed mb-4 sm:mb-10 slide-content transform translate-y-8 opacity-0 transition-all duration-700 delay-200">
            Ikuti berbagai acara reuni dan seminar inspiratif. Jadikan ide-ide besar sebuah kenyataan bersama orang-orang hebat.
          </p>
        </div>
      </div>
    </div>
    
    <!-- CTA Buttons Over Slider -->
    <div class="absolute bottom-24 sm:bottom-32 left-0 right-0 z-30 flex flex-col sm:flex-row justify-center items-center gap-4 px-4">
      <a href="/register" class="relative group px-8 py-4 rounded-full overflow-hidden border border-emerald-500/50 bg-emerald-600/90 backdrop-blur-sm text-white font-medium transition-all shadow-lg hover:shadow-emerald-500/30 hover:-translate-y-1 w-full sm:w-auto text-center">
        <div class="absolute inset-0 w-0 bg-emerald-500 transition-all duration-[300ms] ease-out group-hover:w-full"></div>
        <span class="relative flex items-center justify-center gap-2">
          Mulai Sekarang
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </span>
      </a>
      <a href="/alumni" class="bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/30 text-white px-8 py-4 rounded-full font-medium transition-all duration-300 shadow-sm w-full sm:w-auto text-center">
        Lihat Direktori
      </a>
    </div>

    <!-- Slider Controls -->
    <div class="absolute bottom-10 left-0 right-0 z-30 flex justify-center gap-3" id="slider-dots">
      <button class="w-8 h-2 rounded-full bg-white transition-all"></button>
      <button class="w-2 h-2 rounded-full bg-white/50 transition-all hover:bg-white/80"></button>
      <button class="w-2 h-2 rounded-full bg-white/50 transition-all hover:bg-white/80"></button>
    </div>
  </section>

  <!-- Bento Grid Section -->
  <section class="py-32 relative z-10 border-t border-slate-200 bg-slate-50 overflow-hidden">
    <!-- Ambient glowing blob behind the grid -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-emerald-200/40 rounded-full mix-blend-multiply blur-[120px] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="mb-16 text-center max-w-3xl mx-auto" data-aos="fade-up">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-4">Fitur Terintegrasi</h2>
        <p class="text-slate-500 text-lg">Semua yang Anda butuhkan dalam satu ekosistem eksklusif, dirancang khusus untuk kenyamanan dan produktivitas alumni.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 auto-rows-[280px]">
        
        <!-- Bento Item 1 - Network -->
        <div class="group relative rounded-[2rem] border border-emerald-100/60 shadow-lg shadow-emerald-900/5 overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-emerald-900/10 hover:border-emerald-200 bg-gradient-to-br from-white to-emerald-50" data-aos="fade-up" data-aos-delay="100">
          <div class="relative h-full p-8 flex flex-col justify-between z-10">
            <div class="flex items-start justify-between">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-100 to-teal-100 flex items-center justify-center text-emerald-600 shadow-inner group-hover:scale-110 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-emerald-500 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-2 group-hover:text-emerald-600 transition-colors">Jejaring Sosial</h3>
              <p class="text-slate-500 text-base leading-relaxed">Terhubung dengan ribuan alumni peternakan dengan interaktif.</p>
            </div>
          </div>
        </div>

        <!-- Bento Item 2 - Careers -->
        <div class="group relative rounded-[2rem] border border-amber-100/60 shadow-lg shadow-amber-900/5 overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-amber-900/10 hover:border-amber-200 bg-gradient-to-br from-white to-amber-50" data-aos="fade-up" data-aos-delay="200">
          <div class="relative h-full p-8 flex flex-col justify-between z-10">
            <div class="flex items-start justify-between">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-100 to-orange-100 flex items-center justify-center text-amber-600 shadow-inner group-hover:scale-110 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-amber-500 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">Portal Karir</h3>
              <p class="text-slate-500 text-base leading-relaxed">Akses lowongan kerja eksklusif dan kembangkan jenjang karir Anda.</p>
            </div>
          </div>
        </div>

        <!-- Bento Item 3 - Events -->
        <div class="group relative rounded-[2rem] border border-sky-100/60 shadow-lg shadow-sky-900/5 overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-900/10 hover:border-sky-200 bg-gradient-to-br from-white to-sky-50" data-aos="fade-up" data-aos-delay="300">
          <div class="relative h-full p-8 flex flex-col justify-between z-10">
            <div class="flex items-start justify-between">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-100 to-blue-100 flex items-center justify-center text-sky-600 shadow-inner group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-sky-500 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-2 group-hover:text-sky-600 transition-colors">Agenda Acara</h3>
              <p class="text-slate-500 text-base leading-relaxed">Ikuti reuni, seminar, dan kegiatan sosial resmi KAFAPET secara mudah.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Alumni Showcase Section -->
  <section class="py-32 relative z-10 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6" data-aos="fade-up">
        <div class="max-w-2xl">
          <span class="inline-block px-4 py-1.5 rounded-full bg-sky-100 text-sky-700 text-sm font-semibold mb-4 border border-sky-200">Koneksi KAFAPET</span>
          <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-4">Temukan Sedulur, <br/> Buka Kolaborasi</h2>
          <p class="text-slate-500 text-lg">Mari berjejaring dengan ribuan alumni tangguh yang telah sukses di berbagai bidang. Jangan ragu untuk menyapa dan jalin sinergi!</p>
        </div>
        <a href="/alumni" class="inline-flex items-center gap-2 text-emerald-600 font-semibold hover:text-emerald-700 transition-colors group whitespace-nowrap">
          Lihat Semua Alumni
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Container for static alumni cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Card 1 -->
        <div class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-slate-50 to-emerald-50 rounded-bl-[100px] -z-10 group-hover:scale-110 transition-transform"></div>
          <div class="flex items-start justify-between mb-6">
            <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-bold border border-white shadow-md">BU</div>
            <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-bold rounded-full border border-slate-200">2015</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-1 line-clamp-1 group-hover:text-emerald-600 transition-colors">Budi Santoso</h3>
          <p class="text-emerald-600 text-sm font-medium mb-4">Ilmu Peternakan</p>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-500 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <span class="line-clamp-1">Farm Manager di PT Japfa Comfeed</span>
            </div>
            <div class="flex items-center gap-2 text-slate-500 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="line-clamp-1">Surabaya</span>
            </div>
          </div>
          <a href="/alumni" class="mt-6 w-full py-2.5 rounded-xl border border-emerald-200 text-emerald-600 font-medium text-sm flex items-center justify-center gap-2 group-hover:bg-emerald-50 transition-colors">Lihat Profil</a>
        </div>

        <!-- Card 2 -->
        <div class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-slate-50 to-emerald-50 rounded-bl-[100px] -z-10 group-hover:scale-110 transition-transform"></div>
          <div class="flex items-start justify-between mb-6">
            <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl font-bold border border-white shadow-md">SI</div>
            <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-bold rounded-full border border-slate-200">2018</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-1 line-clamp-1 group-hover:text-emerald-600 transition-colors">Siti Aminah</h3>
          <p class="text-emerald-600 text-sm font-medium mb-4">Teknologi Hasil Peternakan</p>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-500 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <span class="line-clamp-1">QA Supervisor di PT Charoen Pokphand</span>
            </div>
            <div class="flex items-center gap-2 text-slate-500 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="line-clamp-1">Semarang</span>
            </div>
          </div>
          <a href="/alumni" class="mt-6 w-full py-2.5 rounded-xl border border-emerald-200 text-emerald-600 font-medium text-sm flex items-center justify-center gap-2 group-hover:bg-emerald-50 transition-colors">Lihat Profil</a>
        </div>

        <!-- Card 3 -->
        <div class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-slate-50 to-emerald-50 rounded-bl-[100px] -z-10 group-hover:scale-110 transition-transform"></div>
          <div class="flex items-start justify-between mb-6">
            <div class="w-16 h-16 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center text-xl font-bold border border-white shadow-md">AN</div>
            <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-bold rounded-full border border-slate-200">2012</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-1 line-clamp-1 group-hover:text-emerald-600 transition-colors">Andi Pratama</h3>
          <p class="text-emerald-600 text-sm font-medium mb-4">Nutrisi Makanan Ternak</p>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-500 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <span class="line-clamp-1">Nutritionist di PT Malindo</span>
            </div>
            <div class="flex items-center gap-2 text-slate-500 text-sm">

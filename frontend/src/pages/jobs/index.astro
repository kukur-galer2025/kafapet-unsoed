---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Lowongan Kerja">
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white pt-28 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-6">
        <div>
          <h1 class="text-4xl font-bold text-slate-900 mb-2 flex items-center gap-3">
            Portal Karir & Loker
          </h1>
          <p class="text-slate-500 text-lg">Peluang kerja terbaru eksklusif untuk alumni Fakultas Peternakan Unsoed.</p>
        </div>
        <a id="btn-create-job" href="/jobs/create" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-xl transition-colors shadow-lg shadow-emerald-600/30 font-bold flex items-center gap-2 whitespace-nowrap">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Pasang Loker
        </a>
      </div>

      <!-- Search & Filters -->
      <div class="bg-white/90 backdrop-blur-xl rounded-[2rem] shadow-xl shadow-slate-200/50 border border-white/60 p-6 mb-8">
        <div class="flex flex-col md:flex-row gap-4">
          <!-- Search -->
          <div class="flex-1 relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <input 
              type="text" 
              id="search-input"
              placeholder="Cari posisi, perusahaan, atau lokasi..." 
              class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-400 outline-none transition-all text-sm"
            />
          </div>
          <!-- Filter Job Type -->
          <select id="filter-type" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-400 outline-none transition-all text-sm text-slate-700 min-w-[180px]">
            <option value="">Semua Tipe Pekerjaan</option>
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Contract">Contract</option>
            <option value="Freelance">Freelance</option>
            <option value="Internship">Internship</option>
          </select>
        </div>
      </div>

      <p id="results-count" class="text-sm text-slate-500 mb-4 pl-2">Memuat lowongan...</p>

      <!-- Jobs Grid -->
      <div id="jobs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Skeleton loaders -->
        <div class="animate-pulse bg-white rounded-[2rem] border border-slate-200/60 p-8 h-64"></div>
        <div class="animate-pulse bg-white rounded-[2rem] border border-slate-200/60 p-8 h-64 hidden md:block"></div>
        <div class="animate-pulse bg-white rounded-[2rem] border border-slate-200/60 p-8 h-64 hidden lg:block"></div>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  const API_BASE = '/api/v1';
  
  const searchInput = document.getElementById('search-input');
  const filterType = document.getElementById('filter-type');
  const jobsGrid = document.getElementById('jobs-grid');
  const resultsCount = document.getElementById('results-count');

  let debounceTimer;

  function getToken() {
    const match = document.cookie.match(/(^|;)\s*token\s*=\s*([^;]+)/);
    return match ? match[2] : null;
  }
  const token = getToken();

  function timeAgo(dateStr) {
    const diff = Math.floor((new Date() - new Date(dateStr)) / 1000);
    if (diff < 60) return 'Baru saja';
    if (diff < 3600) return `${Math.floor(diff / 60)} menit lalu`;
    if (diff < 86400) return `${Math.floor(diff / 3600)} jam lalu`;
    return `${Math.floor(diff / 86400)} hari lalu`;
  }

  function renderJobCard(job) {
    const avatar = job.user?.profile?.foto_profil 
      ? `<img src="${job.user.profile.foto_profil}" class="w-10 h-10 rounded-full object-cover shadow-sm border border-slate-100"/>`
      : `<div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold shadow-sm border border-emerald-200">U</div>`;
    const posterName = job.user?.profile?.full_name || 'Alumni';

    return `
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-200/60 p-8 hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group">
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 bg-emerald-50 text-emerald-700 text-[10px] font-bold uppercase tracking-wider rounded-md">
            ${job.job_type || 'Full-time'}
          </span>
          <span class="text-xs text-slate-400 font-medium">${timeAgo(job.created_at)}</span>
        </div>
        
        <h3 class="text-xl font-bold text-slate-900 line-clamp-2 mb-1 group-hover:text-emerald-700 transition-colors">${job.title}</h3>
        <p class="text-emerald-600 font-semibold mb-6 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z"/></svg>
          ${job.company}
        </p>
        
        <div class="text-sm text-slate-600 space-y-2.5 mb-8 flex-grow">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="truncate">${job.location || 'Remote / Tidak disebutkan'}</span>
          </div>
          ${job.salary_range ? `
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="truncate text-slate-600 font-medium">${job.salary_range}</span>
            </div>
          ` : ''}
        </div>
        
        <div class="flex items-center justify-between border-t border-slate-100 pt-5 mt-auto">
          <div class="flex items-center gap-2">
            ${avatar}
            <div class="text-[10px] text-slate-500">
              <span class="block text-slate-400">Diposting oleh</span>
              <strong class="text-slate-700">${posterName}</strong>
            </div>
          </div>
          <a href="/jobs/${job.slug || job.id}" class="text-sm text-white bg-slate-900 hover:bg-emerald-600 font-semibold py-2 px-4 rounded-xl transition-colors">
            Detail
          </a>
        </div>
      </div>
    `;
  }

  async function loadJobs() {
    const s = searchInput.value;
    const t = filterType.value;
    let url = `${API_BASE}/jobs?limit=50`;
    if(s) url += `&search=${encodeURIComponent(s)}`;
    if(t) url += `&type=${encodeURIComponent(t)}`;

    try {
      const res = await fetch(url);
      const data = await res.json();
      const jobs = data.data || [];

      resultsCount.textContent = `Menampilkan ${jobs.length} lowongan`;

      if (jobs.length === 0) {
        jobsGrid.innerHTML = `
          <div class="col-span-full text-center py-16 bg-white rounded-[2rem] border border-slate-200/60 shadow-sm">
            <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-300">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-1">Lowongan tidak ditemukan</h3>
            <p class="text-slate-500 text-sm">Coba ubah filter atau kata pencarian Anda.</p>
          </div>
        `;
        return;
      }

      jobsGrid.innerHTML = jobs.map(j => renderJobCard(j)).join('');
    } catch(e) {
      jobsGrid.innerHTML = `<div class="col-span-full bg-red-50 p-4 rounded-xl text-red-700 text-center font-medium">Gagal memuat lowongan.</div>`;
    }
  }

  // Listeners
  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(loadJobs, 400);
  });
  filterType.addEventListener('change', loadJobs);

  loadJobs();
</script>

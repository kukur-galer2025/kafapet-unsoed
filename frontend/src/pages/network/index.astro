                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              </button>
            </div>
          </form>
        </div>

      </div>
    `;
  }

  // Attach event listeners
  function attachListeners() {
    // Three-dot menu toggle (click-based)
    document.querySelectorAll('.post-menu-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const postId = btn.dataset.postId;
        const menu = document.getElementById(`menu-${postId}`);
        // Close all other menus first
        document.querySelectorAll('.post-menu-dropdown.active').forEach(m => {
          if(m !== menu) m.classList.remove('active');
        });
        menu.classList.toggle('active');
      });
    });

    // Close menus when clicking outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.post-menu-dropdown.active').forEach(m => m.classList.remove('active'));
      document.querySelectorAll('.share-dropdown-menu').forEach(m => m.classList.add('hidden'));
    });

    // Share menu toggle
    document.querySelectorAll('.share-toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const postId = btn.dataset.postId;
        const menu = document.getElementById(`share-${postId}`);
        // Close other share menus
        document.querySelectorAll('.share-dropdown-menu').forEach(m => {
          if (m !== menu) m.classList.add('hidden');
        });
        menu.classList.toggle('hidden');
      });
    });

    // Copy link
    document.querySelectorAll('.copy-link-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const url = btn.dataset.url;
        try {
          await navigator.clipboard.writeText(url);
          const originalText = btn.innerHTML;
          btn.innerHTML = `<svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Tersalin!`;
          setTimeout(() => { btn.innerHTML = originalText; }, 2000);
        } catch(err) {
          alert('Gagal menyalin tautan');
        }
      });
    });

    // Lightbox image click
    document.querySelectorAll('.gi[data-lightbox-src]').forEach(gi => {
      gi.addEventListener('click', () => {
        openLightbox(gi.dataset.lightboxSrc);
      });
    });

    // Connect buttons - use event delegation for dynamically loaded buttons
    // (handled globally below)
    
    // Like buttons
    document.querySelectorAll('.like-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!token) { showAuthModal('Masuk untuk Menyukai', 'Like postingan yang menarik perhatian Anda.'); return; }
        try {
          const res = await fetch(`${API_BASE}/posts/${btn.dataset.postId}/like`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }});
          if(res.ok) { const data = await res.json(); btn.querySelector('.like-count').textContent = data.like_count; if(data.liked) { btn.classList.add('text-emerald-600','bg-emerald-50'); } else { btn.classList.remove('text-emerald-600'); } }
        } catch(e){}
      });
    });
    // Edit buttons
    document.querySelectorAll('.edit-post-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const post = JSON.parse(btn.dataset.post);
        openEditModal(post);
      });
    });
    // Delete buttons
    document.querySelectorAll('.delete-post-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        openDeleteModal(btn.dataset.postId);
      });
    });

    // Comment Toggle
    document.querySelectorAll('.comment-toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const postId = btn.dataset.postId;
        const section = document.getElementById(`comment-section-${postId}`);
        section.classList.toggle('hidden');
        
        // Load comments if opened and empty
        if (!section.classList.contains('hidden')) {
          const listContainer = document.getElementById(`comments-list-${postId}`);
          if (listContainer.children.length === 1 && listContainer.children[0].textContent === 'Memuat komentar...') {
            try {
              const res = await fetch(`${API_BASE}/posts/${postId}/comments`);
              if (res.ok) {
                const data = await res.json();
                if (data.count === 0) {
                  listContainer.innerHTML = '<div class="text-center py-4 text-slate-400 text-xs">Belum ada komentar. Jadilah yang pertama!</div>';
                } else {
                  listContainer.innerHTML = data.data.map(c => `
                    <div class="flex gap-3">
                      <div class="w-8 h-8 rounded-full bg-slate-200 flex-shrink-0 flex items-center justify-center text-slate-500 font-bold text-xs">
                        ${getInitials(c.user?.profile?.full_name)}
                      </div>
                      <div class="flex-1 bg-slate-50 rounded-2xl rounded-tl-none p-3 border border-slate-100">
                        <div class="flex justify-between items-baseline mb-1">
                          <span class="font-bold text-slate-800 text-xs">${c.user?.profile?.full_name || 'User'}</span>
                          <span class="text-[10px] text-slate-400">${timeAgo(c.created_at)}</span>
                        </div>
                        <p class="text-slate-600 text-xs">${c.content}</p>
                      </div>
                    </div>
                  `).join('');
                }
              }
            } catch (e) {
              listContainer.innerHTML = '<div class="text-center py-4 text-red-400 text-xs">Gagal memuat komentar</div>';
            }
          }
        }
      });
    });

    // Comment Form Submit
    document.querySelectorAll('.comment-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!token) {
          showAuthModal('Masuk untuk Berkomentar', 'Ikut berdiskusi dengan memberikan komentar Anda.');
          return;
        }
        
        const postId = form.dataset.postId;
        const input = form.querySelector('input[name="content"]');
        const content = input.value.trim();
        if (!content) return;
        
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        
        try {
          const res = await fetch(`${API_BASE}/posts/${postId}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ content })
          });
          
          if (res.ok) {
            const data = await res.json();
            input.value = '';
            
            // Update count on button
            const countSpan = document.querySelector(`.comment-toggle-btn[data-post-id="${postId}"] .comment-count`);
            if (countSpan) countSpan.textContent = data.comment_count;
            
            // Prepend new comment
            const listContainer = document.getElementById(`comments-list-${postId}`);
            const c = data.data;
            const newCommentHTML = `
              <div class="flex gap-3 animate-fade-in-down">
                <div class="w-8 h-8 rounded-full bg-emerald-100 flex-shrink-0 flex items-center justify-center text-emerald-600 font-bold text-xs">
                  ${getInitials(c.user?.profile?.full_name)}
                </div>
                <div class="flex-1 bg-emerald-50/50 rounded-2xl rounded-tl-none p-3 border border-emerald-100">
                  <div class="flex justify-between items-baseline mb-1">
                    <span class="font-bold text-slate-800 text-xs">${c.user?.profile?.full_name || 'User'}</span>
                    <span class="text-[10px] text-emerald-500">Baru saja</span>
                  </div>
                  <p class="text-slate-600 text-xs">${c.content}</p>
                </div>
              </div>
            `;
            
            if (listContainer.innerHTML.includes('Belum ada komentar')) {
              listContainer.innerHTML = newCommentHTML;
            } else {
              listContainer.insertAdjacentHTML('beforeend', newCommentHTML); // Add to bottom since order is ASC
            }
            
            // Scroll to bottom of list
            listContainer.scrollTop = listContainer.scrollHeight;
          }
        } catch (e) {
          console.error(e);
        } finally {
          submitBtn.disabled = false;
        }
      });
    });
  }

  // Load Feed
  async function loadFeed() {
    const feedContainer = document.getElementById('feed-container');
    try {
      const res = await fetch(`${API_BASE}/posts`);
      const data = await res.json();
      if(data.data && data.data.length > 0) {
        feedContainer.innerHTML = data.data.map(post => renderPostCard(post)).join('');
      } else {
        feedContainer.innerHTML = '<div class="text-center py-10 bg-white rounded-3xl border border-slate-200 text-slate-500">Belum ada postingan.</div>';
      }
    } catch (error) {
      feedContainer.innerHTML = '<div class="text-center py-10 text-red-500">Gagal memuat feed.</div>';
    }
    attachListeners();
  }

  // Post form submission (multi-image)
  const form = document.getElementById('postForm');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if(!token) return;
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.innerHTML = 'Mengirim...';
    submitBtn.disabled = true;
    
    const formData = new FormData();
    formData.append('content', document.getElementById('content').value);
    
    const tagsVal = document.getElementById('tags').value;
    if(tagsVal) {
      formData.append('tags', tagsVal);
    }
    
    const files = document.getElementById('images').files;
    for(let i = 0; i < Math.min(files.length, 4); i++) {
      formData.append('images', files[i]);
    }

    try {
      const res = await fetch(`${API_BASE}/posts`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
      if(res.ok) {
        document.getElementById('content').value = '';
        document.getElementById('tags').value = '';
        document.getElementById('images').value = '';
        document.getElementById('imagePreviewGrid').innerHTML = '';
        document.getElementById('imagePreviewGrid').classList.add('hidden');
        submitBtn.innerHTML = 'Kirim';
        submitBtn.disabled = false;
        loadFeed();
      } else {
        const data = await res.json();
        document.getElementById('errorMsg').textContent = data.error;
        document.getElementById('errorMsg').classList.remove('hidden');
        submitBtn.innerHTML = 'Kirim';
        submitBtn.disabled = false;
      }
    } catch(err) {
      submitBtn.innerHTML = 'Kirim';
      submitBtn.disabled = false;
    }
  });

  // Multi-image preview for create form
  document.getElementById('images')?.addEventListener('change', (e) => {
    const files = e.target.files;
    const grid = document.getElementById('imagePreviewGrid');
    grid.innerHTML = '';
    if(files.length > 0) {
      grid.classList.remove('hidden');
      grid.style.display = 'grid';
      for(let i = 0; i < Math.min(files.length, 4); i++) {
        const div = document.createElement('div');
        div.className = 'relative group';
        div.innerHTML = `
          <img src="${URL.createObjectURL(files[i])}" class="w-full h-24 object-cover rounded-xl border border-slate-200 shadow-sm" />
        `;
        grid.appendChild(div);
      }
      if(files.length > 4) {
        document.getElementById('errorMsg').textContent = 'Maksimal 4 gambar. Hanya 4 gambar pertama yang akan diunggah.';
        document.getElementById('errorMsg').classList.remove('hidden');
      }
    } else {
      grid.classList.add('hidden');
    }
  });

  // Fetch Dynamic Sidebars
  async function fetchSuggestedAlumni() {
    const container = document.getElementById('suggestions-container');
    if (!container) return;
    try {
      const headers = token ? { 'Authorization': `Bearer ${token}` } : {};
      const res = await fetch(`${API_BASE}/alumni/suggested`, { headers });
      const data = await res.json();
      if(data.data && data.data.length > 0) {
        let filteredAlumni = data.data;
        if (currentUser && currentUser.followed_ids) {
          filteredAlumni = data.data.filter(p => !currentUser.followed_ids.includes(p.user_id));
        }
        
        if (filteredAlumni.length > 0) {
          container.innerHTML = filteredAlumni.slice(0, 3).map(profile => {
            const avatarHTML = profile.foto_profil
              ? `<img src="${profile.foto_profil}" alt="${profile.full_name}" class="w-full h-full object-cover" />`
              : getInitials(profile.full_name);
              
            return `
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-slate-200 rounded-xl flex items-center justify-center text-slate-500 font-bold overflow-hidden">${avatarHTML}</div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-slate-900 truncate">${profile.full_name || 'Alumni'}</p>
                <p class="text-[10px] text-slate-500 truncate">${profile.angkatan ? 'Angkatan ' + profile.angkatan : 'Alumni'} &bull; ${profile.total_likes || 0} Likes</p>
              </div>
              <button class="connect-btn-dummy w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white flex items-center justify-center transition-colors" title="Connect" data-user-id="${profile.user_id}">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              </button>
            </div>
          `}).join('');
        } else {
          container.innerHTML = '<p class="text-xs text-slate-500 text-center">Tidak ada saran alumni baru.</p>';
        }
      } else {
        container.innerHTML = '<p class="text-xs text-slate-500 text-center">Belum ada saran alumni.</p>';
      }
    } catch(err) {
      console.error(err);
    }
  }

  async function fetchTrendingTags() {
    const container = document.getElementById('trending-tags-container');
    if (!container) return;
    try {
      const res = await fetch(`${API_BASE}/tags/trending`);
      const data = await res.json();
      if(data.data && data.data.length > 0) {
        container.innerHTML = data.data.map((item, idx) => {
          let category = 'Populer';
          if(idx === 0) category = 'Paling Hangat';
          else if(item.tag.toLowerCase().includes('loker') || item.tag.toLowerCase().includes('karir')) category = 'Loker & Karir';
          else if(item.tag.toLowerCase().includes('event') || item.tag.toLowerCase().includes('kampus')) category = 'Event Kampus';

          return `
            <div class="group cursor-pointer">
              <p class="text-xs text-slate-400 mb-0.5">${category}</p>
              <p class="font-semibold text-slate-700 text-sm group-hover:text-emerald-600 transition-colors">${item.tag}</p>
              <p class="text-[10px] text-slate-400">${item.count} post</p>
            </div>
          `;
        }).join('');
      } else {
        container.innerHTML = '<p class="text-xs text-slate-500 text-center">Belum ada tren topik.</p>';
      }
    } catch(err) {
      console.error(err);
    }
  }

  // Init
  initAuthData().then(() => {
    loadFeed();
    fetchSuggestedAlumni();
    fetchTrendingTags();
  });

  // Global event delegation for connect/disconnect buttons
  document.addEventListener('click', async (e) => {
    // Handle CONNECT buttons (follow)
    const connectBtn = e.target.closest('.connect-btn, .connect-btn-dummy');
    if (connectBtn) {
      if (!token) { showAuthModal('Masuk untuk Terhubung', 'Bangun jejaring profesional Anda.'); return; }
      const targetId = connectBtn.dataset.userId;
      if (!targetId) return;

      connectBtn.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/users/${targetId}/follow`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }});
        if (res.ok || (await res.clone().json().catch(() => ({}))).error === "Already following this user") {
          connectBtn.innerHTML = `<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Connected`;
          connectBtn.className = 'connected-btn text-white bg-slate-800 hover:bg-red-600 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1 transition-colors';
          connectBtn.dataset.userId = targetId;
          connectBtn.disabled = false;
          if (currentUser && currentUser.followed_ids && !currentUser.followed_ids.includes(parseInt(targetId))) {
            currentUser.followed_ids.push(parseInt(targetId));
            const el = document.getElementById('sidebar-following');
            if (el) el.textContent = parseInt(el.textContent) + 1;
          }
        } else { connectBtn.disabled = false; }
      } catch(err) { connectBtn.disabled = false; }
      return;
    }

    // Handle CONNECTED buttons (unfollow)
    const connectedBtn = e.target.closest('.connected-btn');
    if (connectedBtn) {
      if (!token) return;
      const targetId = connectedBtn.dataset.userId;
      if (!targetId) return;

      connectedBtn.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/users/${targetId}/follow`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` }});
        if (res.ok) {
          connectedBtn.innerHTML = `<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Connect`;
          connectedBtn.className = 'connect-btn text-emerald-600 hover:text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3 py-1 rounded-full text-xs font-bold transition-colors flex items-center gap-1';
          connectedBtn.dataset.userId = targetId;
          connectedBtn.disabled = false;
          if (currentUser && currentUser.followed_ids) {
            currentUser.followed_ids = currentUser.followed_ids.filter(id => id !== parseInt(targetId));
            const el = document.getElementById('sidebar-following');
            if (el) el.textContent = Math.max(0, parseInt(el.textContent) - 1);
          }
        } else { connectedBtn.disabled = false; }
      } catch(err) { connectedBtn.disabled = false; }
      return;
    }
  });

  // ===================== Connections Modal Logic =====================
  const netModal = document.getElementById('net-connections-modal');
  const netList = document.getElementById('net-connections-list');
  const netTabFollowers = document.getElementById('net-tab-followers');
  const netTabFollowing = document.getElementById('net-tab-following');
  let netConnData = { followers: [], following: [] };

  function netRenderConnections(type) {
    const list = type === 'followers' ? netConnData.followers : netConnData.following;
    
    // Update tabs
    if (type === 'followers') {
      netTabFollowers.className = 'flex-1 py-3 text-sm font-bold text-slate-900 border-b-2 border-slate-900 transition-colors';
      netTabFollowing.className = 'flex-1 py-3 text-sm font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-600 transition-colors';
    } else {
      netTabFollowing.className = 'flex-1 py-3 text-sm font-bold text-slate-900 border-b-2 border-slate-900 transition-colors';
      netTabFollowers.className = 'flex-1 py-3 text-sm font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-600 transition-colors';
    }

    if (!list || list.length === 0) {
      netList.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm">Belum ada data.</div>`;
      return;
    }

    netList.innerHTML = list.map(conn => {
      const isFollowerTab = type === 'followers';
      const userObj = isFollowerTab ? conn.follower : conn.followee;
      const profile = userObj?.profile;
      if (!profile) return '';
      
      const avatarHTML = profile.foto_profil
        ? `<img src="${profile.foto_profil}" alt="Avatar" class="w-full h-full object-cover" />`
        : getInitials(profile.full_name || 'User');

      let btnHTML = '';
      if (isFollowerTab) {
        const doWeFollow = currentUser?.followed_ids?.includes(userObj.id);
        if (doWeFollow) {
          btnHTML = `<button class="net-conn-action text-slate-600 bg-slate-100 hover:bg-red-50 hover:text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-action="unfollow" data-id="${userObj.id}">Hapus</button>`;
        } else {
          btnHTML = `<button class="net-conn-action text-emerald-600 bg-emerald-50 hover:bg-emerald-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-action="follow" data-id="${userObj.id}">Ikuti Balik</button>`;
        }
      } else {
        btnHTML = `<button class="net-conn-action text-slate-600 bg-slate-100 hover:bg-red-50 hover:text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-action="unfollow" data-id="${userObj.id}">Berhenti Mengikuti</button>`;
      }

      return `
        <div class="flex items-center gap-3 p-3 hover:bg-white rounded-xl transition-colors mb-1">
          <div class="w-10 h-10 bg-slate-200 rounded-full flex items-center justify-center text-slate-500 font-bold overflow-hidden">
            ${avatarHTML}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-slate-900 truncate">${profile.full_name || 'User'}</p>
            <p class="text-[11px] text-slate-500 truncate">${profile.pekerjaan_saat_ini || 'Alumni'}</p>
          </div>
          ${btnHTML}
        </div>
      `;
    }).join('');
  }

  async function netOpenModal(type) {
    if (!currentUser) return;
    netModal.style.display = 'flex';
    netModal.classList.remove('hidden');
    netList.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm flex justify-center"><svg class="animate-spin w-6 h-6" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>`;
    
    // Set tabs early
    if (type === 'followers') {
      netTabFollowers.className = 'flex-1 py-3 text-sm font-bold text-slate-900 border-b-2 border-slate-900 transition-colors';
      netTabFollowing.className = 'flex-1 py-3 text-sm font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-600 transition-colors';
    } else {
      netTabFollowing.className = 'flex-1 py-3 text-sm font-bold text-slate-900 border-b-2 border-slate-900 transition-colors';
      netTabFollowers.className = 'flex-1 py-3 text-sm font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-600 transition-colors';
    }

    try {
      const res = await fetch(`${API_BASE}/users/${currentUser.user_id}/connections`);
      if (res.ok) {
        netConnData = await res.json();
        document.getElementById('sidebar-followers').textContent = netConnData.follower_count;
        document.getElementById('sidebar-following').textContent = netConnData.following_count;
        netRenderConnections(type);
      }
    } catch(e) {
      netList.innerHTML = `<div class="py-8 text-center text-red-500 text-sm">Gagal memuat data.</div>`;
    }
  }

  document.getElementById('net-followers-btn')?.addEventListener('click', () => netOpenModal('followers'));
  document.getElementById('net-following-btn')?.addEventListener('click', () => netOpenModal('following'));
  netTabFollowers?.addEventListener('click', () => netRenderConnections('followers'));
  netTabFollowing?.addEventListener('click', () => netRenderConnections('following'));

  [document.getElementById('net-close-connections'), document.getElementById('net-connections-modal-bg')].forEach(el => {
    el?.addEventListener('click', () => { netModal.style.display = 'none'; });
  });

  // Handle Follow/Unfollow actions inside modal
  netList?.addEventListener('click', async (e) => {
    const btn = e.target.closest('.net-conn-action');
    if (!btn) return;

    const action = btn.dataset.action;
    const targetId = btn.dataset.id;
    if (!targetId) return;

    btn.disabled = true;
    const origText = btn.innerHTML;
    btn.innerHTML = `<svg class="animate-spin w-4 h-4 mx-auto" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    try {
      const res = await fetch(`${API_BASE}/users/${targetId}/follow`, {
        method: action === 'follow' ? 'POST' : 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (res.ok) {
        // Update followed_ids locally
        if (action === 'follow' && currentUser.followed_ids) {
          currentUser.followed_ids.push(parseInt(targetId));
        } else if (action === 'unfollow' && currentUser.followed_ids) {
          currentUser.followed_ids = currentUser.followed_ids.filter(id => id !== parseInt(targetId));
        }
        // Refetch connections and re-render
        const freshRes = await fetch(`${API_BASE}/users/${currentUser.user_id}/connections`);
        if (freshRes.ok) {
          netConnData = await freshRes.json();
          document.getElementById('sidebar-followers').textContent = netConnData.follower_count;
          document.getElementById('sidebar-following').textContent = netConnData.following_count;
          const activeTab = netTabFollowers.classList.contains('border-slate-900') ? 'followers' : 'following';
          netRenderConnections(activeTab);
        }
        // Also update Connected buttons in feed
        loadFeed();
      } else {
        btn.innerHTML = origText;
        btn.disabled = false;
      }
    } catch(err) {
      btn.innerHTML = origText;
      btn.disabled = false;
    }
  });

</script>

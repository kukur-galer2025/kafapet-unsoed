---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { updateProfile } from '../../utils/api';

let error = '';
let success = false;
const token = Astro.cookies.get('token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

let initialProfile: any = {
  full_name: '',
  angkatan: '',
  prodi: '',
  pekerjaan_saat_ini: '',
  perusahaan: '',
  domisili_kota: '',
};

try {
  const res = await fetch('http://localhost:3000/api/v1/auth/me', {
    headers: { 'Authorization': `Bearer ${token}` }
  });
  if (res.ok) {
    const data = await res.json();
    if (data.profile) {
      initialProfile = data.profile;
    }
  }
} catch (e) {
  console.error("Failed to fetch initial profile", e);
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const profileData = {
      full_name: data.get('full_name')?.toString() || '',
      angkatan: data.get('angkatan')?.toString() || '',
      prodi: data.get('prodi')?.toString() || '',
      pekerjaan_saat_ini: data.get('pekerjaan_saat_ini')?.toString() || '',
      perusahaan: data.get('perusahaan')?.toString() || '',
      domisili_kota: data.get('domisili_kota')?.toString() || '',
    };
    
    await updateProfile(token, profileData);
    success = true;
    initialProfile = profileData; // Update form with new data
  } catch (err: any) {
    error = err.message;
  }
}

---

<BaseLayout title="Edit Profil">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-12">
    <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Profil Anda</h1>
      
      {error && (
        <div class="bg-red-50 p-4 rounded-md text-red-700 mb-6">{error}</div>
      )}
      
      {success && (
        <div class="bg-green-50 p-4 rounded-md text-green-700 mb-6">Profil berhasil diperbarui!</div>
      )}
      
      <form method="POST" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Nama Lengkap -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Lengkap</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              </div>
              <input type="text" name="full_name" value={initialProfile.full_name} class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm shadow-sm placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" required>
            </div>
          </div>
          
          <!-- Angkatan -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Angkatan (Tahun Masuk)</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <input type="text" name="angkatan" value={initialProfile.angkatan} class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm shadow-sm placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors">
            </div>
          </div>
          
          <!-- Program Studi -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Program Studi</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
              </div>
              <select name="prodi" class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm shadow-sm focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors appearance-none">
                <option value="" selected={initialProfile.prodi === ''}>-- Pilih Program Studi --</option>
                <option value="D3 Budi Daya Ternak" selected={initialProfile.prodi === 'D3 Budi Daya Ternak'}>D3 Budi Daya Ternak</option>
                <option value="S1 Peternakan" selected={initialProfile.prodi === 'S1 Peternakan'}>S1 Peternakan</option>
                <option value="S2 Peternakan" selected={initialProfile.prodi === 'S2 Peternakan'}>S2 Peternakan</option>
                <option value="S3 Peternakan" selected={initialProfile.prodi === 'S3 Peternakan'}>S3 Peternakan</option>
              </select>
              <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
                <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
          
          <!-- Kota Domisili -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Kota Domisili</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <input type="text" name="domisili_kota" value={initialProfile.domisili_kota} class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm shadow-sm placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors">
            </div>
          </div>
          
          <!-- Pekerjaan Saat Ini -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Pekerjaan / Jabatan</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <input type="text" name="pekerjaan_saat_ini" value={initialProfile.pekerjaan_saat_ini} class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm shadow-sm placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors">
            </div>
          </div>
          
          <!-- Nama Perusahaan -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Perusahaan / Instansi</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              </div>
              <input type="text" name="perusahaan" value={initialProfile.perusahaan} class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm shadow-sm placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors">
            </div>
          </div>
          
        </div>
        
        <div class="flex justify-end pt-8 mt-4 border-t border-slate-100">
          <button type="submit" class="flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-700 hover:to-emerald-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg shadow-emerald-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-all hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Simpan Profil
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

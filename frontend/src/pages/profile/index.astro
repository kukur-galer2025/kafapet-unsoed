---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Profil Saya — KAFAPET">
  <!-- Profile Banner -->
  <div class="relative h-64 md:h-80 bg-slate-900 overflow-hidden">
    <!-- Abstract gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-emerald-900 to-slate-900">
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-emerald-500/20 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-sky-500/20 rounded-full blur-[80px]"></div>
    </div>
  </div>

  <!-- Profile Content Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 pb-20 -mt-24 md:-mt-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- ================= LEFT COLUMN: PROFILE CARD & STATS ================= -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Main Profile Card -->
        <div class="bg-white/90 backdrop-blur-xl rounded-[2rem] shadow-xl shadow-slate-200/50 border border-white/60 relative">
          <div class="p-8 text-center pt-16 relative">
            <!-- Avatar -->
            <label class="absolute -top-16 left-1/2 -translate-x-1/2 group cursor-pointer" for="avatar-input" id="avatar-upload-trigger">
              <div id="profile-avatar" class="w-32 h-32 bg-gradient-to-br from-emerald-400 to-sky-500 rounded-3xl flex items-center justify-center text-white font-bold text-5xl shadow-xl shadow-emerald-200/50 ring-8 ring-white z-10 transition-transform hover:scale-105 overflow-hidden">
                -
              </div>
              <div class="absolute inset-0 bg-black/50 rounded-3xl flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-20">
                <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span class="text-[9px] text-white/90 font-medium mt-1 uppercase tracking-wider">Ubah Foto</span>
              </div>
              <input type="file" id="avatar-input" name="avatar" class="hidden" accept="image/png, image/jpeg, image/jpg, image/webp" />
            </label>
            
            <h2 id="profile-name" class="text-2xl font-bold text-slate-900 mb-0.5 mt-2">Memuat...</h2>
            <p class="text-[10px] text-slate-400 mb-2 font-medium tracking-wide">Maks 5MB (JPG, PNG, WEBP)</p>
            <p id="profile-headline" class="text-slate-500 font-medium mb-6">Memuat profil</p>
            
            <div class="flex justify-center gap-3 mb-8">
              <a href="/profile/edit" class="flex-1 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl transition-all shadow-sm">
                Edit Profil
              </a>
              <button class="w-12 flex items-center justify-center bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-400 hover:text-slate-700 rounded-xl transition-all shadow-sm">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
              </button>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-3 gap-4 border-t border-slate-100 pt-6">
              <div id="followers-btn" class="text-center group cursor-pointer">
                <p id="profile-followers" class="text-2xl font-bold text-emerald-600 group-hover:text-emerald-700 transition-colors">0</p>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1">Pengikut</p>
              </div>
              <div id="following-btn" class="text-center group cursor-pointer">
                <p id="profile-following" class="text-2xl font-bold text-sky-600 group-hover:text-sky-700 transition-colors">0</p>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1">Diikuti</p>
              </div>
              <div class="text-center group cursor-pointer">
                <p id="profile-likes" class="text-2xl font-bold text-pink-600 group-hover:text-pink-700 transition-colors">0</p>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1">Disukai</p>
              </div>
            </div>
          </div>
        </div>

        <!-- About / Details Card -->
        <div class="bg-white/90 backdrop-blur-xl rounded-[2rem] shadow-xl shadow-slate-200/50 border border-white/60 p-8">
          <h3 class="font-bold text-slate-900 mb-6 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Informasi Pribadi
          </h3>
          
          <div class="space-y-5">
            <div>
              <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1">Angkatan</p>
              <p id="profile-angkatan" class="text-slate-800 font-medium">-</p>
            </div>
            <div>
              <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1">Program Studi</p>
              <p id="profile-prodi" class="text-slate-800 font-medium">-</p>
            </div>
            <div>
              <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1">Perusahaan</p>
              <p id="profile-perusahaan" class="text-slate-800 font-medium">-</p>
            </div>
            <div>
              <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1">Domisili Kota</p>
              <p id="profile-domisili" class="text-slate-800 font-medium">-</p>
            </div>
          </div>
        </div>

      </div>

      <!-- ================= RIGHT COLUMN: FEED / POSTS ================= -->
      <div class="lg:col-span-8 mt-32 md:mt-40 lg:mt-40 space-y-6">
        <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
          <svg class="w-6 h-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5L18.5 8" /></svg>
          Aktivitas & Postingan
        </h3>

        <!-- Feed List Container -->
        <div id="user-feed-container" class="space-y-6">
          <div class="text-center py-12 bg-white rounded-[2rem] border border-slate-200/60 shadow-sm">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
            <p class="text-slate-500 font-medium">Memuat aktivitas...</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  {/* Lightbox Modal */}
  <div id="lightbox-modal" class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/90 backdrop-blur-md cursor-zoom-out" style="display:none;">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-2 transition-all z-10"><svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
    <img id="lightbox-img" src="" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl" style="animation: modalIn 0.2s ease-out;" />
  </div>

  {/* Connections Modal */}
  <div id="connections-modal" class="fixed inset-0 z-[150] hidden items-center justify-center p-4" style="display:none;">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" id="connections-modal-bg"></div>
    <div class="bg-white rounded-[2rem] w-full max-w-md shadow-2xl relative z-10 overflow-hidden flex flex-col max-h-[85vh]" style="animation: modalIn 0.2s ease-out;">
      <!-- Header -->
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-white relative z-20">
        <h3 class="font-bold text-slate-900 text-lg" id="connections-modal-title">Koneksi</h3>
        <button id="close-connections-modal" class="text-slate-400 hover:text-slate-600 hover:bg-slate-50 p-2 rounded-full transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      
      <!-- Tabs -->
      <div class="flex border-b border-slate-100 bg-white relative z-20">
        <button id="tab-followers" class="flex-1 py-3 text-sm font-bold text-slate-900 border-b-2 border-slate-900 transition-colors">Pengikut</button>
        <button id="tab-following" class="flex-1 py-3 text-sm font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-600 transition-colors">Diikuti</button>
      </div>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto p-2 bg-slate-50/50 relative z-10 custom-scrollbar" id="connections-list">
        <div class="py-8 text-center text-slate-400 text-sm">Memuat...</div>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  const API_BASE = 'http://localhost:3000/api/v1';
  let currentUser = null;
  
  function getToken() {
    const match = document.cookie.match(/(^|;)\s*token\s*=\s*([^;]+)/);
    return match ? match[2] : null;
  }
  const token = getToken();

  if (!token) {
    window.location.href = '/login';
  }

  function getInitials(name) { return name ? name.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() : 'U'; }
  function timeAgo(dateStr) {
    const diff = Math.floor((new Date() - new Date(dateStr)) / 1000);
    if (diff < 60) return 'Baru saja';
    if (diff < 3600) return `${Math.floor(diff / 60)}mnt`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}j`;
    return `${Math.floor(diff / 86400)}h`;
  }

  async function loadProfile() {
    try {
      // Fetch current user and profile
      const res = await fetch(`${API_BASE}/auth/me`, { headers: { 'Authorization': `Bearer ${token}` }});
      if(res.ok) {
        const data = await res.json();
        currentUser = data;
        const profile = data.profile;
        
        const fullName = profile?.full_name || 'User Baru';
        document.getElementById('profile-name').textContent = fullName;
        const avatarContainer = document.getElementById('profile-avatar');
        if (profile?.foto_profil) {
          avatarContainer.innerHTML = `<img src="${profile.foto_profil}" alt="Avatar" class="w-full h-full object-cover" />`;
        } else {
          avatarContainer.textContent = getInitials(fullName);
        }
        
        document.getElementById('profile-likes').textContent = data.total_likes || 0;
        
        // Setup Avatar Upload
        const avatarInput = document.getElementById('avatar-input');
        avatarInput?.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if(!file) return;
          
          if(file.size > 5 * 1024 * 1024) {
            alert('Ukuran file maksimal 5MB');
            return;
          }
          
          const formData = new FormData();
          formData.append('avatar', file);
          
          try {
            avatarContainer.innerHTML = `<svg class="animate-spin w-8 h-8 text-white" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
            
            const res = await fetch(`${API_BASE}/alumni/profile/avatar`, {
              method: 'PUT',
              headers: { 'Authorization': `Bearer ${token}` },
              body: formData
            });
            
            if(res.ok) {
              const resData = await res.json();
              const newFoto = resData.data.foto_profil;
              avatarContainer.innerHTML = `<img src="${newFoto}" alt="Avatar" class="w-full h-full object-cover" />`;
              alert('Foto profil berhasil diperbarui!');
            } else {
              const errData = await res.json();
              alert(errData.error || 'Gagal mengubah foto profil');
              loadProfile(); // reload old avatar
            }
          } catch(err) {
            console.error(err);
            alert('Terjadi kesalahan jaringan');
            loadProfile();
          }
        });
        
        document.getElementById('profile-headline').textContent = profile?.pekerjaan_saat_ini || 'Belum ada pekerjaan';
        document.getElementById('profile-angkatan').textContent = profile?.angkatan || 'Belum diisi';
        document.getElementById('profile-prodi').textContent = profile?.prodi || 'Belum diisi';
        document.getElementById('profile-perusahaan').textContent = profile?.perusahaan || 'Belum diisi';
        document.getElementById('profile-domisili').textContent = profile?.domisili_kota || 'Belum diisi';

        // Load connections
        loadConnections(data.user_id);
        
        // Load User's Posts
        loadUserPosts(data.user_id, fullName, profile?.angkatan, profile?.perusahaan, profile?.pekerjaan_saat_ini, profile?.foto_profil);
      } else {
        window.location.href = '/login';
      }
    } catch(e) {
      console.error(e);
    }
  }

  async function loadConnections(userId) {
    try {
      const res = await fetch(`${API_BASE}/users/${userId}/connections`);
      if(res.ok) {
        const data = await res.json();
        document.getElementById('profile-followers').textContent = data.follower_count;
        document.getElementById('profile-following').textContent = data.following_count;
      }
    } catch(e){}
  }

  function buildImageGrid(post) {
    let images = [];
    try { images = JSON.parse(post.images || '[]'); } catch(e) {}
    if(images.length === 0 && post.image_url) images = [post.image_url];
    if(images.length === 0) return '';

    const gridClass = `g${Math.min(images.length, 4)}`;
    const items = images.slice(0, 4).map(url => `
      <div class="gi" data-lightbox-src="${url}">
        <img src="${url}" loading="lazy" alt="Post image" />
      </div>
    `).join('');

    return `<div class="image-grid ${gridClass} mb-4">${items}</div>`;
  }

  function renderPostCard(post, authorName, authorAngkatan, authorPerusahaan, authorPekerjaan, authorFoto) {
    const avatarHTML = authorFoto 
      ? `<img src="${authorFoto}" alt="${authorName}" class="w-full h-full object-cover" />`
      : getInitials(authorName);
    const date = timeAgo(post.created_at);
    const imageHTML = buildImageGrid(post);
    
    let jobText = '';
    if (authorPekerjaan && authorPerusahaan) jobText = `${authorPekerjaan} di ${authorPerusahaan}`;
    else if (authorPekerjaan) jobText = authorPekerjaan;
    else if (authorPerusahaan) jobText = authorPerusahaan;

    return `
      <div class="bg-white rounded-[2rem] border border-slate-200/60 p-6 overflow-hidden transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/50">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-sky-500 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-sm ring-2 ring-white overflow-hidden">
            ${avatarHTML}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-900 text-sm truncate">${authorName}</h3>
              ${authorAngkatan ? `<span class="text-[9px] px-1.5 py-0.5 bg-emerald-50 text-emerald-600 border border-emerald-100 rounded-md font-bold tracking-wide">Angkatan ${authorAngkatan}</span>` : ''}
            </div>
            <div class="flex items-center gap-2 mt-0.5">
              ${jobText ? `
                <span class="text-[11px] font-medium text-slate-500 truncate flex items-center gap-1">
                  <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  ${jobText}
                </span>
                <span class="text-slate-300 text-[10px]">•</span>
              ` : ''}
              <p class="text-[11px] text-slate-400">${date}</p>
            </div>
          </div>
        </div>
        
        <p class="text-slate-700 text-sm leading-relaxed mb-4 whitespace-pre-line">${post.content}</p>
        ${imageHTML}
        
        <div class="flex items-center justify-between border-t border-slate-100 pt-3 text-slate-500 text-xs font-medium">
          <div class="flex items-center gap-6">
            <div class="flex items-center gap-1.5">
               <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
               <span>${post.like_count || 0} Suka</span>
            </div>
            <button class="comment-toggle-btn flex items-center gap-1.5 hover:text-sky-600 transition-colors" data-post-id="${post.id}">
               <svg class="w-4 h-4 text-sky-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/></svg>
               <span class="comment-count">${post.comment_count || 0} Komentar</span>
            </button>
          </div>
          
          <div class="relative">
            <button class="share-toggle-btn flex items-center gap-1.5 hover:text-indigo-600 transition-colors bg-slate-50 hover:bg-indigo-50 px-3 py-1.5 rounded-lg" data-post-id="${post.id}">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
              <span>Bagikan</span>
            </button>
            <div class="share-dropdown-menu hidden absolute right-0 bottom-full mb-2 w-44 bg-white rounded-xl shadow-lg shadow-slate-200/50 border border-slate-100 overflow-hidden z-20" id="share-${post.id}">
              <button class="copy-link-btn w-full text-left px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2" data-url="${window.location.origin}/post/${post.slug || post.id}">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                Salin Tautan
              </button>
              <a href="https://wa.me/?text=${encodeURIComponent('Lihat postingan ini di Kafapet: ' + window.location.origin + '/post/' + (post.slug || post.id))}" target="_blank" class="w-full text-left px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
              </a>
            </div>
          </div>
        </div>
        
        <!-- Inline Comment Section (Hidden by default) -->
        <div id="comment-section-${post.id}" class="hidden mt-4 border-t border-slate-100 pt-4">
          <div id="comments-list-${post.id}" class="space-y-4 mb-4 max-h-60 overflow-y-auto pr-2 custom-scrollbar">
            <div class="text-center py-4 text-slate-400 text-xs">Memuat komentar...</div>
          </div>
          <form class="comment-form flex gap-3" data-post-id="${post.id}">
            <div class="w-8 h-8 rounded-full bg-slate-200 flex-shrink-0 flex items-center justify-center text-slate-500 font-bold text-xs">
              ${currentUser ? getInitials(currentUser.profile?.full_name || 'User') : 'U'}
            </div>
            <div class="flex-1 relative">
              <input type="text" name="content" required placeholder="Tulis komentar..." class="w-full bg-slate-50 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all pr-10" />
              <button type="submit" class="absolute right-1.5 top-1.5 p-1 text-emerald-500 hover:bg-emerald-50 rounded-full transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              </button>
            </div>
          </form>
        </div>
        
      </div>
    `;
  }

  async function loadUserPosts(userId, fullName, angkatan, perusahaan, pekerjaan, foto) {
    const feedContainer = document.getElementById('user-feed-container');
    try {
      const res = await fetch(`${API_BASE}/posts?user_id=${userId}`);
      const data = await res.json();
      
      if(data.data && data.data.length > 0) {
        feedContainer.innerHTML = data.data.map(post => renderPostCard(post, fullName, angkatan, perusahaan, pekerjaan, foto)).join('');
      } else {
        feedContainer.innerHTML = `
          <div class="text-center py-16 bg-white rounded-[2rem] border border-slate-200/60 shadow-sm">
            <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-300">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5L18.5 8" /></svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-1">Belum ada aktivitas</h3>
            <p class="text-slate-500 text-sm">Anda belum membuat postingan apa pun.</p>
          </div>
        `;
      }
    } catch (error) {
      feedContainer.innerHTML = '<div class="text-center py-10 text-red-500 bg-red-50 rounded-2xl">Gagal memuat feed.</div>';
    }
  }

  // Init
  loadProfile();

  // Event Delegation for Share Menu
  document.addEventListener('click', async (e) => {
    // Close share menus if clicking outside
    if (!e.target.closest('.share-toggle-btn')) {
      document.querySelectorAll('.share-dropdown-menu').forEach(m => m.classList.add('hidden'));
    }

    // Toggle share menu
    const toggleBtn = e.target.closest('.share-toggle-btn');
    if (toggleBtn) {
      e.stopPropagation();
      const postId = toggleBtn.dataset.postId;
      const menu = document.getElementById(`share-${postId}`);
      if (menu) {
        // Close others
        document.querySelectorAll('.share-dropdown-menu').forEach(m => {
          if (m !== menu) m.classList.add('hidden');
        });
        menu.classList.toggle('hidden');
      }
    }

    // Copy link
    const copyBtn = e.target.closest('.copy-link-btn');
    if (copyBtn) {
      e.stopPropagation();
      const url = copyBtn.dataset.url;
      try {
        await navigator.clipboard.writeText(url);
        const originalText = copyBtn.innerHTML;
        copyBtn.innerHTML = `<svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Tersalin!`;
        setTimeout(() => { copyBtn.innerHTML = originalText; }, 2000);
      } catch(err) {
        alert('Gagal menyalin tautan');
      }
    }

    // Comment Toggle
    const commentToggleBtn = e.target.closest('.comment-toggle-btn');
    if (commentToggleBtn) {
      e.stopPropagation();
      const postId = commentToggleBtn.dataset.postId;
      const section = document.getElementById(`comment-section-${postId}`);
      if (section) {
        section.classList.toggle('hidden');
        
        // Load comments if opened and empty
        if (!section.classList.contains('hidden')) {
          const listContainer = document.getElementById(`comments-list-${postId}`);
          if (listContainer && listContainer.children.length === 1 && listContainer.children[0].textContent === 'Memuat komentar...') {
            try {
              const res = await fetch(`${API_BASE}/posts/${postId}/comments`);
              if (res.ok) {
                const data = await res.json();
                if (data.count === 0) {
                  listContainer.innerHTML = '<div class="text-center py-4 text-slate-400 text-xs">Belum ada komentar. Jadilah yang pertama!</div>';
                } else {
                  listContainer.innerHTML = data.data.map(c => `
                    <div class="flex gap-3">
                      <div class="w-8 h-8 rounded-full bg-slate-200 flex-shrink-0 flex items-center justify-center text-slate-500 font-bold text-xs">
                        ${getInitials(c.user?.profile?.full_name)}
                      </div>
                      <div class="flex-1 bg-slate-50 rounded-2xl rounded-tl-none p-3 border border-slate-100">
                        <div class="flex justify-between items-baseline mb-1">
                          <span class="font-bold text-slate-800 text-xs">${c.user?.profile?.full_name || 'User'}</span>
                          <span class="text-[10px] text-slate-400">${timeAgo(c.created_at)}</span>
                        </div>
                        <p class="text-slate-600 text-xs">${c.content}</p>
                      </div>
                    </div>
                  `).join('');
                }
              }
            } catch (err) {
              listContainer.innerHTML = '<div class="text-center py-4 text-red-400 text-xs">Gagal memuat komentar</div>';
            }
          }
        }
      }
    }
  });

  // Event Delegation for Form Submit (Comments)
  document.addEventListener('submit', async (e) => {
    if (e.target.matches('.comment-form')) {
      e.preventDefault();
      const form = e.target;
      if (!token) {
        alert('Anda harus masuk untuk berkomentar');
        window.location.href = '/login';
        return;
      }
      
      const postId = form.dataset.postId;
      const input = form.querySelector('input[name="content"]');
      const content = input.value.trim();
      if (!content) return;
      
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      
      try {
        const res = await fetch(`${API_BASE}/posts/${postId}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ content })
        });
        
        if (res.ok) {
          const data = await res.json();
          input.value = '';
          
          // Update count on button
          const countSpan = document.querySelector(`.comment-toggle-btn[data-post-id="${postId}"] .comment-count`);
          if (countSpan) countSpan.textContent = data.comment_count + " Komentar";
          
          // Prepend new comment
          const listContainer = document.getElementById(`comments-list-${postId}`);
          if (listContainer) {
            const c = data.data;
            const newCommentHTML = `
              <div class="flex gap-3 animate-fade-in-down">
                <div class="w-8 h-8 rounded-full bg-emerald-100 flex-shrink-0 flex items-center justify-center text-emerald-600 font-bold text-xs">
                  ${getInitials(c.user?.profile?.full_name)}
                </div>
                <div class="flex-1 bg-emerald-50/50 rounded-2xl rounded-tl-none p-3 border border-emerald-100">
                  <div class="flex justify-between items-baseline mb-1">
                    <span class="font-bold text-slate-800 text-xs">${c.user?.profile?.full_name || 'User'}</span>
                    <span class="text-[10px] text-emerald-500">Baru saja</span>
                  </div>
                  <p class="text-slate-600 text-xs">${c.content}</p>
                </div>
              </div>
            `;
            
            if (listContainer.innerHTML.includes('Belum ada komentar')) {
              listContainer.innerHTML = newCommentHTML;
            } else {
              listContainer.insertAdjacentHTML('beforeend', newCommentHTML);
            }
            listContainer.scrollTop = listContainer.scrollHeight;
          }
        }
      } catch (err) {
        console.error(err);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    }
  });
  
  // Lightbox Logic
  const lightboxModal = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img');
  
  document.addEventListener('click', (e) => {
    const gi = e.target.closest('.gi');
    if(gi && gi.dataset.lightboxSrc) {
      lightboxImg.src = gi.dataset.lightboxSrc;
      lightboxModal.style.display = 'flex';
      lightboxModal.classList.remove('hidden');
    }
  });

  document.getElementById('lightbox-close')?.addEventListener('click', () => {
    lightboxModal.style.display = 'none';
  });
  lightboxModal?.addEventListener('click', (e) => {
    if(e.target === lightboxModal) lightboxModal.style.display = 'none';
  });

  // Connections Modal Logic
  const connectionsModal = document.getElementById('connections-modal');
  const closeConnectionsModal = document.getElementById('close-connections-modal');
  const connectionsModalBg = document.getElementById('connections-modal-bg');
  const tabFollowers = document.getElementById('tab-followers');
  const tabFollowing = document.getElementById('tab-following');
  const connectionsList = document.getElementById('connections-list');
  
  let currentConnections = { followers: [], following: [] };

  function renderConnections(type) {
    const list = type === 'followers' ? currentConnections.followers : currentConnections.following;
    
    // Update tabs styling
    if(type === 'followers') {
      tabFollowers.classList.replace('text-slate-400', 'text-slate-900');
      tabFollowers.classList.replace('border-transparent', 'border-slate-900');
      tabFollowing.classList.replace('text-slate-900', 'text-slate-400');
      tabFollowing.classList.replace('border-slate-900', 'border-transparent');
    } else {
      tabFollowing.classList.replace('text-slate-400', 'text-slate-900');
      tabFollowing.classList.replace('border-transparent', 'border-slate-900');
      tabFollowers.classList.replace('text-slate-900', 'text-slate-400');
      tabFollowers.classList.replace('border-slate-900', 'border-transparent');
    }

    if(list.length === 0) {
      connectionsList.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm">Belum ada data.</div>`;
      return;
    }

    connectionsList.innerHTML = list.map(conn => {
      const isFollowerTab = type === 'followers';
      const userObj = isFollowerTab ? conn.follower : conn.followee;
      const profile = userObj.profile;
      const avatarHTML = profile.foto_profil
        ? `<img src="${profile.foto_profil}" alt="Avatar" class="w-full h-full object-cover" />`
        : getInitials(profile.full_name || 'User');
      
      // Determine button
      let btnHTML = '';
      if(isFollowerTab) {
        // If they follow us, do we follow them back?
        const doWeFollow = currentUser?.followed_ids?.includes(userObj.id);
        if(doWeFollow) {
          btnHTML = `<button class="connection-action-btn text-slate-600 bg-slate-100 hover:bg-red-50 hover:text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-action="unfollow" data-id="${userObj.id}">Hapus</button>`;
        } else {
          btnHTML = `<button class="connection-action-btn text-emerald-600 bg-emerald-50 hover:bg-emerald-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-action="follow" data-id="${userObj.id}">Ikuti Balik</button>`;
        }
      } else {
        // We follow them -> Unfollow
        btnHTML = `<button class="connection-action-btn text-slate-600 bg-slate-100 hover:bg-red-50 hover:text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-action="unfollow" data-id="${userObj.id}">Berhenti Mengikuti</button>`;
      }

      return `
        <div class="flex items-center gap-3 p-3 hover:bg-white rounded-xl transition-colors mb-1">
          <div class="w-10 h-10 bg-slate-200 rounded-full flex items-center justify-center text-slate-500 font-bold overflow-hidden">
            ${avatarHTML}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-slate-900 truncate">${profile.full_name || 'User'}</p>
            <p class="text-[11px] text-slate-500 truncate">${profile.pekerjaan_saat_ini || 'Alumni'}</p>
          </div>
          ${btnHTML}
        </div>
      `;
    }).join('');
  }

  async function openConnectionsModal(type) {
    if(!currentUser) return;
    connectionsModal.style.display = 'flex';
    connectionsModal.classList.remove('hidden');
    connectionsList.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm flex justify-center"><svg class="animate-spin w-6 h-6" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>`;
    
    // update tabs early
    if(type === 'followers') {
      tabFollowers.classList.replace('text-slate-400', 'text-slate-900');
      tabFollowers.classList.replace('border-transparent', 'border-slate-900');
      tabFollowing.classList.replace('text-slate-900', 'text-slate-400');
      tabFollowing.classList.replace('border-slate-900', 'border-transparent');
    } else {
      tabFollowing.classList.replace('text-slate-400', 'text-slate-900');
      tabFollowing.classList.replace('border-transparent', 'border-slate-900');
      tabFollowers.classList.replace('text-slate-900', 'text-slate-400');
      tabFollowers.classList.replace('border-slate-900', 'border-transparent');
    }

    try {
      const res = await fetch(`${API_BASE}/users/${currentUser.user_id}/connections`);
      if(res.ok) {
        currentConnections = await res.json();
        // Update profile counts while we're at it
        document.getElementById('profile-followers').textContent = currentConnections.follower_count;
        document.getElementById('profile-following').textContent = currentConnections.following_count;
        renderConnections(type);
      }
    } catch(e) {
      connectionsList.innerHTML = `<div class="py-8 text-center text-red-500 text-sm">Gagal memuat data.</div>`;
    }
  }

  document.getElementById('followers-btn')?.addEventListener('click', () => openConnectionsModal('followers'));
  document.getElementById('following-btn')?.addEventListener('click', () => openConnectionsModal('following'));
  tabFollowers?.addEventListener('click', () => renderConnections('followers'));
  tabFollowing?.addEventListener('click', () => renderConnections('following'));
  
  [closeConnectionsModal, connectionsModalBg].forEach(el => {
    el?.addEventListener('click', () => {
      connectionsModal.style.display = 'none';
    });
  });

  // Handle Follow/Unfollow actions in Modal
  connectionsList?.addEventListener('click', async (e) => {
    const btn = e.target.closest('.connection-action-btn');
    if(!btn) return;

    const action = btn.dataset.action;
    const targetId = btn.dataset.id;
    if(!targetId) return;

    btn.disabled = true;
    const originalText = btn.innerHTML;
    btn.innerHTML = `<svg class="animate-spin w-4 h-4 mx-auto" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    try {
      const res = await fetch(`${API_BASE}/users/${targetId}/follow`, {
        method: action === 'follow' ? 'POST' : 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if(res.ok) {
        // Refetch to get fresh data
        const freshRes = await fetch(`${API_BASE}/users/${currentUser.user_id}/connections`);
        if(freshRes.ok) {
           currentConnections = await freshRes.json();
           document.getElementById('profile-followers').textContent = currentConnections.follower_count;
           document.getElementById('profile-following').textContent = currentConnections.following_count;
           
           // Update currentUser.followed_ids locally
           if(action === 'follow' && currentUser.followed_ids) {
             currentUser.followed_ids.push(parseInt(targetId));
           } else if(action === 'unfollow' && currentUser.followed_ids) {
             currentUser.followed_ids = currentUser.followed_ids.filter(id => id !== parseInt(targetId));
           }
           
           // Re-render the current tab
           const activeTab = tabFollowers.classList.contains('border-slate-900') ? 'followers' : 'following';
           renderConnections(activeTab);
        }
      } else {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    } catch(err) {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });

</script>

<style is:global>
  @keyframes modalIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
  .post-card { transition: all 0.3s; }
  .post-card:hover { transform: translateY(-2px); box-shadow: 0 15px 30px -10px rgba(0,0,0,0.1); }

  /* Image Grid - compact thumbnails */
  .image-grid { display: grid; gap: 3px; border-radius: 14px; overflow: hidden; border: 1px solid rgba(0,0,0,0.06); }
  .image-grid.g1 { grid-template-columns: 1fr; max-height: 280px; }
  .image-grid.g2 { grid-template-columns: 1fr 1fr; max-height: 200px; }
  .image-grid.g3 { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; max-height: 220px; }
  .image-grid.g3 .gi:first-child { grid-row: 1 / 3; }
  .image-grid.g4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; max-height: 240px; }
  .image-grid .gi { overflow: hidden; cursor: pointer; position: relative; background: #f1f5f9; }
  .image-grid .gi img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .image-grid .gi:hover img { transform: scale(1.05); }
  
  /* Three-dot dropdown - click based */
  .post-menu-dropdown {
    display: none; position: absolute; right: 0; top: calc(100% + 4px); z-index: 50;
    min-width: 160px; background: white; border-radius: 14px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.12), 0 0 0 1px rgba(0,0,0,0.04);
    padding: 4px; overflow: hidden;
    animation: modalIn 0.15s ease-out;
  }
  .post-menu-dropdown.active { display: block; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Direktori Alumni">
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white pt-28 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="mb-10">
        <h1 class="text-4xl font-bold text-slate-900 mb-2">Direktori Alumni KAFAPET</h1>
        <p class="text-slate-500 text-lg">Temukan dan hubungi jejaring alumni Fakultas Peternakan Unsoed.</p>
      </div>

      <!-- Search & Filters -->
      <div class="bg-white/90 backdrop-blur-xl rounded-[2rem] shadow-xl shadow-slate-200/50 border border-white/60 p-6 mb-8">
        <div class="flex flex-col md:flex-row gap-4">
          <!-- Search -->
          <div class="flex-1 relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <input 
              type="text" 
              id="search-input"
              placeholder="Cari berdasarkan nama..." 
              class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-400 outline-none transition-all text-sm"
            />
          </div>
          <!-- Filter Angkatan -->
          <select id="filter-angkatan" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-400 outline-none transition-all text-sm text-slate-700 min-w-[160px]">
            <option value="">Semua Angkatan</option>
          </select>
          <!-- Filter Prodi -->
          <select id="filter-prodi" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-400 outline-none transition-all text-sm text-slate-700 min-w-[180px]">
            <option value="">Semua Program Studi</option>
          </select>
        </div>
      </div>

      <!-- Results Count -->
      <p id="results-count" class="text-sm text-slate-500 mb-4 pl-2">Memuat...</p>

      <!-- Alumni Grid -->
      <div id="alumni-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Skeleton loaders -->
        <div class="animate-pulse bg-white rounded-[2rem] border border-slate-200/60 p-6">
          <div class="flex items-center gap-4 mb-4"><div class="w-16 h-16 bg-slate-200 rounded-2xl"></div><div class="flex-1 space-y-2"><div class="h-4 bg-slate-200 rounded w-2/3"></div><div class="h-3 bg-slate-100 rounded w-1/2"></div></div></div>
          <div class="space-y-2"><div class="h-3 bg-slate-100 rounded w-full"></div><div class="h-3 bg-slate-100 rounded w-3/4"></div></div>
        </div>
        <div class="animate-pulse bg-white rounded-[2rem] border border-slate-200/60 p-6 hidden md:block">
          <div class="flex items-center gap-4 mb-4"><div class="w-16 h-16 bg-slate-200 rounded-2xl"></div><div class="flex-1 space-y-2"><div class="h-4 bg-slate-200 rounded w-2/3"></div><div class="h-3 bg-slate-100 rounded w-1/2"></div></div></div>
          <div class="space-y-2"><div class="h-3 bg-slate-100 rounded w-full"></div><div class="h-3 bg-slate-100 rounded w-3/4"></div></div>
        </div>
        <div class="animate-pulse bg-white rounded-[2rem] border border-slate-200/60 p-6 hidden lg:block">
          <div class="flex items-center gap-4 mb-4"><div class="w-16 h-16 bg-slate-200 rounded-2xl"></div><div class="flex-1 space-y-2"><div class="h-4 bg-slate-200 rounded w-2/3"></div><div class="h-3 bg-slate-100 rounded w-1/2"></div></div></div>
          <div class="space-y-2"><div class="h-3 bg-slate-100 rounded w-full"></div><div class="h-3 bg-slate-100 rounded w-3/4"></div></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const API_BASE = 'http://localhost:3000/api/v1';
  const searchInput = document.getElementById('search-input');
  const filterAngkatan = document.getElementById('filter-angkatan');
  const filterProdi = document.getElementById('filter-prodi');
  const alumniGrid = document.getElementById('alumni-grid');
  const resultsCount = document.getElementById('results-count');

  let allAlumni = [];
  let debounceTimer;

  function getInitials(name) { return name ? name.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() : 'U'; }

  function renderAlumniCard(profile) {
    const avatarHTML = profile.foto_profil
      ? `<img src="${profile.foto_profil}" alt="${profile.full_name}" class="w-full h-full object-cover" />`
      : `<span class="text-2xl font-bold">${getInitials(profile.full_name)}</span>`;
    
    const pekerjaan = profile.pekerjaan_saat_ini || 'Profesi belum diisi';
    const perusahaan = profile.perusahaan || 'Perusahaan belum diisi';
    const domisili = profile.domisili_kota || 'Lokasi belum diisi';

    return `
      <a href="/alumni/${profile.user_id}" class="block bg-white rounded-[2rem] border border-slate-200/60 p-6 hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-1 transition-all group">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-400 to-sky-500 rounded-2xl flex items-center justify-center text-white shadow-md ring-2 ring-white overflow-hidden flex-shrink-0">
            ${avatarHTML}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 transition-colors truncate">${profile.full_name}</h3>
            <p class="text-sm text-emerald-600 font-medium">${profile.prodi || 'Fakultas Peternakan'}${profile.angkatan ? ` '${profile.angkatan.toString().slice(-2)}` : ''}</p>
          </div>
        </div>
        <div class="space-y-2 text-sm text-slate-600">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="truncate">${pekerjaan}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z"/></svg>
            <span class="truncate">${perusahaan}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="truncate">${domisili}</span>
          </div>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <span class="text-sm text-emerald-600 font-semibold group-hover:text-emerald-700 transition-colors">Lihat Profil Lengkap &rarr;</span>
        </div>
      </a>
    `;
  }

  function filterAndRender() {
    const search = searchInput.value.toLowerCase().trim();
    const angkatan = filterAngkatan.value;
    const prodi = filterProdi.value;

    let filtered = allAlumni;

    if (search) {
      filtered = filtered.filter(p => p.full_name.toLowerCase().includes(search));
    }
    if (angkatan) {
      filtered = filtered.filter(p => p.angkatan === angkatan);
    }
    if (prodi) {
      filtered = filtered.filter(p => p.prodi === prodi);
    }

    resultsCount.textContent = `Menampilkan ${filtered.length} dari ${allAlumni.length} alumni`;

    if (filtered.length === 0) {
      alumniGrid.innerHTML = `
        <div class="col-span-full text-center py-16 bg-white rounded-[2rem] border border-slate-200/60 shadow-sm">
          <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-300">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-1">Tidak Ditemukan</h3>
          <p class="text-slate-500 text-sm">Coba ubah kata kunci atau filter Anda.</p>
        </div>
      `;
      return;
    }

    alumniGrid.innerHTML = filtered.map(p => renderAlumniCard(p)).join('');
  }

  async function loadAlumni() {
    try {
      const res = await fetch(`${API_BASE}/alumni?limit=100`);
      const data = await res.json();
      allAlumni = data.data || [];

      // Populate filter options dynamically
      const angkatanSet = new Set();
      const prodiSet = new Set();
      allAlumni.forEach(p => {
        if (p.angkatan) angkatanSet.add(p.angkatan);
        if (p.prodi) prodiSet.add(p.prodi);
      });
      
      // Sort angkatan descending
      [...angkatanSet].sort((a, b) => b.localeCompare(a)).forEach(a => {
        const opt = document.createElement('option');
        opt.value = a;
        opt.textContent = `Angkatan ${a}`;
        filterAngkatan.appendChild(opt);
      });

      [...prodiSet].sort().forEach(p => {
        const opt = document.createElement('option');
        opt.value = p;
        opt.textContent = p;
        filterProdi.appendChild(opt);
      });

      filterAndRender();
    } catch(e) {
      alumniGrid.innerHTML = `<div class="col-span-full bg-red-50 p-4 rounded-xl text-red-700 text-center">Gagal memuat data alumni.</div>`;
    }
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(filterAndRender, 300);
  });
  filterAngkatan.addEventListener('change', filterAndRender);
  filterProdi.addEventListener('change', filterAndRender);

  loadAlumni();
</script>

---
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import 'aos/dist/aos.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | KAFAPET Unsoed</title>
	</head>
	<body class="bg-[#F8FAFC] text-slate-800 min-h-screen font-sans selection:bg-emerald-500 selection:text-white flex flex-col overflow-x-hidden">
		<main class="flex-grow relative z-10 h-screen">
			<slot />
		</main>

    <script>
      import AOS from 'aos';
      document.addEventListener('DOMContentLoaded', () => {
        AOS.init({
          duration: 1000,
          once: true,
          offset: 50,
          easing: 'ease-out-cubic',
        });
      });
    </script>
	</body>
</html>
